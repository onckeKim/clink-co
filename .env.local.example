# ---------------------------------------------------------------------------
# Clink & Co by HEIMSIGHT — environment variables
# Copy this file to `.env.local` and fill in real values.
# `.env.local` is gitignored — never commit real credentials.
# ---------------------------------------------------------------------------

# Supabase (Project Settings -> API)
# Used for authentication, the product/category/order database, and file
# storage (product images, user avatars). See src/lib/supabase/.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
# Server-only. Never expose this to the client — used in server actions /
# route handlers that need to bypass Row Level Security (e.g. admin tasks).
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Public site URL — used for metadata, canonical links and OpenGraph tags.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Stripe (or your preferred payment provider) — required once checkout is
# implemented. Not yet wired up in this foundation build.
STRIPE_SECRET_KEY=your-stripe-secret-key
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=your-stripe-publishable-key
STRIPE_WEBHOOK_SECRET=your-stripe-webhook-signing-secret

# Transactional email (e.g. Resend) — for order confirmations and the
# newsletter signup handled in src/components/layout/NewsletterForm.tsx.
RESEND_API_KEY=your-resend-api-key
