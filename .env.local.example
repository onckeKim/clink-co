# ---------------------------------------------------------------------------
# Clink & Co by HEIMSIGHT — environment variables
# Copy this file to `.env.local` and fill in real values.
# `.env.local` is gitignored — never commit real credentials.
# ---------------------------------------------------------------------------

# Supabase (Project Settings -> API)
# Used for authentication, the product/category/order database, and file
# storage (product images, user avatars). See src/lib/supabase/.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
# Server-only. Never expose this to the client — used in server actions /
# route handlers that need to bypass Row Level Security (e.g. admin tasks).
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Public site URL — used for metadata, canonical links and OpenGraph tags,
# and to build the redirect URLs Supabase sends verification/recovery
# emails to (see src/app/auth/confirm/route.ts).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Authentication — see src/app/login, src/app/signup, src/lib/supabase/dal.ts.
# Email/password auth works as soon as the Supabase vars above are set; no
# extra vars are required for it. See the README's auth setup section for
# the one manual step (customizing Supabase's email templates) that makes
# verification/recovery links land on this app's own pages.
# ---------------------------------------------------------------------------

# Social login structure — off by default. Set to "true" only after also
# enabling the Google provider in the Supabase dashboard (Authentication ->
# Providers -> Google); see src/components/auth/SocialLoginButtons.tsx.
NEXT_PUBLIC_ENABLE_SOCIAL_LOGIN=false

# ---------------------------------------------------------------------------
# Admin dashboard — see src/lib/admin/roles.ts, src/app/admin.
# ---------------------------------------------------------------------------

# Comma-separated list of email addresses to auto-grant the "Super
# Administrator" role the first time each one signs up or logs in. This is
# the ONLY way to create the first admin — every admin role after that is
# granted from within the dashboard itself (/admin/team, super_admin only),
# not through this env var. Safe to leave more than one address here (e.g.
# founder + first ops hire); already-created accounts are unaffected by
# later changes to this list. Case-insensitive, no spaces needed around commas.
ADMIN_BOOTSTRAP_EMAILS=owner@example.com,ops@example.com

# ---------------------------------------------------------------------------
# Payments — see src/lib/payments/. Each gateway is a self-contained
# provider (src/lib/payments/providers/*.ts) that reports itself as
# available via isConfigured() once its required vars below are set — that
# is what "enabled by the administrator" means in this build. Leave a
# provider's vars unset to hide it from checkout entirely. Secrets here are
# only ever read server-side (route handlers), never bundled to the client.
# ---------------------------------------------------------------------------

# Test payment provider — a fully working mock gateway, no external account
# needed. Always available outside production; in production it stays off
# unless explicitly turned on (useful for a staging/demo deploy).
ENABLE_TEST_PAYMENTS=false
TEST_PAYMENT_WEBHOOK_SECRET=test-secret

# EFT / bank transfer — no gateway, no webhook (manually reconciled by an
# administrator against the bank statement). On by default; set to "false"
# to disable it. Bank details shown to customers live in src/config/payments.ts.
EFT_ENABLED=true

# PayFast (https://www.payfast.co.za) — Merchant Settings -> Integration
PAYFAST_MERCHANT_ID=your-payfast-merchant-id
PAYFAST_MERCHANT_KEY=your-payfast-merchant-key
PAYFAST_PASSPHRASE=your-payfast-passphrase
PAYFAST_SANDBOX=true

# Peach Payments (https://peachpayments.com) — Dashboard -> Checkout API
PEACH_ENTITY_ID=your-peach-entity-id
PEACH_ACCESS_TOKEN=your-peach-access-token
PEACH_API_BASE_URL=https://testapi-v2.peachpayments.com
PEACH_WEBHOOK_SECRET=your-peach-webhook-secret

# Yoco (https://www.yoco.com) — Portal -> Online -> API Keys
YOCO_SECRET_KEY=your-yoco-secret-key
YOCO_WEBHOOK_SECRET=your-yoco-webhook-secret

# Ozow (https://ozow.com) — Business Portal -> Settings -> API
OZOW_SITE_CODE=your-ozow-site-code
OZOW_PRIVATE_KEY=your-ozow-private-key
OZOW_SANDBOX=true

# ---------------------------------------------------------------------------
# Transactional email — see src/lib/email/ (the provider-neutral service)
# and src/lib/email.ts (every template-triggering function the app calls).
# Left fully unset, every email is logged to the server console AND written
# to a local .email-previews/*.html file instead of sent — nothing fails,
# nothing is lost, see src/lib/email/providers/console.ts. Preview every
# template without any of this configured at /dev/emails (development only).
# ---------------------------------------------------------------------------

# Which provider actually sends — "resend" | "sendgrid" | "postmark" |
# "console". Leave unset to auto-pick the first provider below with a key
# set (Resend, then SendGrid, then Postmark), or "console" if none are.
EMAIL_PROVIDER=

# Resend (https://resend.com) — Dashboard -> API Keys
RESEND_API_KEY=your-resend-api-key

# SendGrid (https://sendgrid.com) — Settings -> API Keys
SENDGRID_API_KEY=your-sendgrid-api-key

# Postmark (https://postmarkapp.com) — Servers -> API Tokens
POSTMARK_SERVER_TOKEN=your-postmark-server-token

# Signs one-click unsubscribe links (back-in-stock, wishlist reminder,
# abandoned cart — see src/lib/email/unsubscribe.ts). Falls back to an
# insecure development-only value if unset; set a real random value
# (`openssl rand -hex 32`) before sending any real marketing email.
EMAIL_UNSUBSCRIBE_SECRET=

# Authorizes POST requests to /api/cron/** (currently just
# abandoned-cart-emails — see src/lib/email/cron-auth.ts). Required for
# any cron route to run at all; point your scheduler at the route with
# `Authorization: Bearer <this value>`. Generate with `openssl rand -hex 32`.
CRON_SECRET=

# ---------------------------------------------------------------------------
# WhatsApp notifications — dormant scaffold, see src/lib/whatsapp/README.md.
# Setting these alone does NOT start sending anything: WHATSAPP_ENABLED must
# be exactly "true" AND every call site must already have real, explicit
# per-customer consent for this channel (this app doesn't capture that yet
# — see the README before wiring any call site).
# ---------------------------------------------------------------------------
WHATSAPP_ENABLED=false
WHATSAPP_ACCESS_TOKEN=your-whatsapp-cloud-api-access-token
WHATSAPP_PHONE_NUMBER_ID=your-whatsapp-phone-number-id
